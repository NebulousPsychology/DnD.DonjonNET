{
  "$schema": "https://json-schema.org/draft-07/schema",
  // "$schema": "https://json-schema.org/draft/2020-12/schema", (insufficient support)
  "$id": "https://example.com/donjon.schema.json",
  "title": "Donjon Map",
  "description": "A product in the catalog",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "cell_bit":{ 
      "type": "object",
      "properties": {
        "aperture":{"type":"integer"},
        "arch":{"type":"integer"},
        "block":{"type":"integer"},
        "door":{"type":"integer"},
        "label":{"type":"integer"},
        "locked":{"type":"integer"},
        "nothing":{"type":"integer"},
        "perimeter":{"type":"integer"},
        "portcullis":{"type":"integer"},
        "room":{"type":"integer"},
        "room_id":{"type":"integer"},
        "secret":{"type":"integer"},
        "stair_down":{"type":"integer"},
        "stair_up":{"type":"integer"},
        "trapped":{"type":"integer"}
      }
    },
    "cells":{ "type": "array", "items": { "type":"array", "items": {"type":"integer"}} },
    "corridor_features":{ "type":  "object" },
    "details":{
      "type": "object",
      "properties": {
        "floor":{"type": "string" },
        "illumination":{"type": "string" },
        "size":{"type": "string" },
        "special": { "oneOf":[{"type": "string" }, {"type":"null"}]},
        "temperature":{"type": "string" },
        "walls":{"type": "string" }
      }
    },
    "egress":{
      "type": "array",
      "items": {
        "type":"object",
        "properties": {
          "col":{ "type": "integer" },
          "row":{ "type": "integer" },
          "depth":{ "type": "integer" },
          "dir":{ "enum": ["north","south","east","west"]},
          "type":{"enum": ["corridor","room"]}
        }
      }
    },
    "rooms":{ "type": "array"},
    "settings":{ "type": "object" },
    "wandering_monsters":{ "type":"object" }
  }
}
