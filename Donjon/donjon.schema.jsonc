{
  "$schema": "https://json-schema.org/draft-07/schema",
  // "$schema": "https://json-schema.org/draft/2020-12/schema", (insufficient support)
  "$id": "https://example.com/donjon.schema.json",
  "title": "Donjon Map",
  "description": "A product in the catalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cell_bit":{ 
      "type": "object",
      "properties": {
        "aperture":{"type":"integer"},
        "arch":{"type":"integer"},
        "block":{"type":"integer"},
        "door":{"type":"integer"},
        "label":{"type":"integer"},
        "locked":{"type":"integer"},
        "nothing":{"type":"integer"},
        "perimeter":{"type":"integer"},
        "portcullis":{"type":"integer"},
        "room":{"type":"integer"},
        "room_id":{"type":"integer"},
        "secret":{"type":"integer"},
        "stair_down":{"type":"integer"},
        "stair_up":{"type":"integer"},
        "trapped":{"type":"integer"}
      }
    },
    "cells":{ "type": "array", "items": { "type":"array", "items": {"type":"integer"}} },
    "corridor_features":{
      "type":  "object",
      "patternProperties": {
        "^[A-Za-z0-9]+$":{
          "additionalItems": false,
          "properties": {
            "detail":{"type":"string"},
            "key":{"type":"string"},
            "marks":{
              "type":"array",
              "items": { "properties": {
                "col":{"type":"integer"},
                "row":{"type":"integer"}
              }}
            },
            "summary":{"type":"string"}
          }
        }
      }
    },
    "details":{
      "type": "object",
      "properties": {
        "floor":{"type": "string" },
        "illumination":{"type": "string" },
        "size":{"type": "string" },
        "special": { "oneOf":[{"type": "string" }, {"type":"null"}]},
        "temperature":{"type": "string" },
        "walls":{"type": "string" }
      }
    },
    "egress":{
      "type": "array",
      "items": {
        "type":"object",
        "properties": {
          "col":{ "type": "integer" },
          "row":{ "type": "integer" },
          "depth":{ "type": "integer" },
          "dir":{ "enum": ["north","south","east","west"]},
          "type":{"enum": ["corridor","room"]}
        }
      }
    },
    "rooms":{ 
      "type": "array",
      "items": {
        "oneOf": [
          {"type":"null"},
          {
            "type":"object",
            "properties": {
              "area":{"type":"integer"},
              "blocks":{"type":"array"},
              "cells":{"type":"integer"},
              "col":{"type":"integer"},
              "composite":{"type":"integer"},
              "contents":{
                "type":"object",
                "properties": {
                  "detail":{
                    "properties": {
                      "trap":{"type": "array", "items": {"type":"string"}},
                      "monster":{"type": "array", "items": {"type":"string"}},
                      "hidden_treasure":{"type": "array", "items": {"type":"string"}},
                      "room_features":{"type":"string"}
                    }// /props
                  },
                  "inhabited":{"type":"string"},
                  "summary":{"type":"string"}
                }
              },
              "east":{"type":"integer"},
              "height":{"type":"integer"},
              "id":{"type":"string"},
              "north":{"type":"integer"},
              "offset":{"type":"number"},
              "row":{"type":"integer"},
              "south":{"type":"integer"},
              "west":{"type":"integer"},
              "width":{"type":"integer"}
            }
          }
        ]
      }
    },
    "settings":{ 
      "properties": {
        "add_stairs":{"type":"string"},
        "bleed":{"type":"integer"},
        "cell_size":{"type":"integer"},
        "corridor_layout":{"type":"string", "enum": ["Labyrinth","Errant","Straight"]},
        "door_set":{"type":"string", "enum": ["None","Basic","Secure","Standard","Deathtrap"]},
        "dungeon_layout":{"type":"string", "enum": [
          "Square","Rectangle","Box","Cross",
          "Dagger","Saltire","Keep",
          "Hexagon","Round","Cavernous"]},
        "dungeon_size":{"type":"string", "enum": [
          "Fine","Diminutive","Tiny",
          "Small","Medium","Large","Huge",
          "Gargantuan","Colossal","Custom"
          ]},
        "grid":{"type":"string", "enum": ["Square","Hex","VertHex","None"]},
        "image_size":{"type":"string"},
        "infest":{"enum": ["None","Basic"]},
        "last_room_id":{"type":"integer"},
        "level":{"oneOf":[{"type":"integer"}, {"type":"string"}]},
        "map_cols":{"oneOf":[{"type":"integer"}, {"type":"string"}]},
        "map_rows":{"oneOf":[{"type":"integer"}, {"type":"string"}]},
        "map_style":{
          "type":"string",
          "enum": [
            "Standard",
            // ...
            "Steampunk"
            ]},
        "max_col":{"type":"integer"},
        "max_row":{"type":"integer"},
        "motif":{"type":"string",
        // if Infest == Basic
          "enum": ["","None", "Abandoned",
            "Aberrant", "Giant", "Undead", "Vermin",
            "Aquatic","Desert","Underdark",
            "Arcane","Fire","Cold","Abyssal","Infernal"
          ]
        },
        "n_cols":{"type":"integer"},
        "n_i":{"type":"integer"},
        "n_j":{"type":"integer"},
        "n_pc":{"oneOf":[{"type":"integer"}, {"type":"string"}]},
        "n_rooms":{"type":"integer"},
        "n_rows":{"type":"integer"},
        "name":{"type":"string"},
        "peripheral_egress":{"enum": ["Yes","No","Many","Tiling"]},
        "remove_deadends":{"enum": ["None","Some","All"]},
        "room_layout":{"enum": ["Scattered","Sparse","Dense","Symmetric"]},
        "room_polymorph":{"enum": ["Yes","No","Many"]},
        "room_size":{"enum": ["Small","Medium","Large","Huge","Gargantuan","Colossal"]},
        "seed":{"oneOf":[{"type":"integer"}, {"type":"string"}]}
      },
      "type": "object"
    },
    "stairs":{
      "type":"array",
      "items": {
        "properties": {
          "col":{"type":"integer"},
          "row":{"type":"integer"},
          "dir":{"enum": ["north","east","south","west"]},
          "key":{"enum": ["down","up"]}
        }
      }
    },
    "wandering_monsters":{ "type":"object" },
    "$schema":true
  }
}
